const manifest = {
  "id": "laucs.addon",
  "name": "Laucs community addon",
  "description": "A Community driven Addon Because why not - Permanent Version",
  "version": "7.7.7-permanent",
  "resources": ["search", "stream"],
  "types": ["music"],
  "behaviorHints": { "configurable": true },
  "config": [
    {
      "key": "quality",
      "type": "select",
      "title": "Audio quality",
      "default": "lossless",
      "options": ["lossless", "high", "low", "potato"]
    }
  ]
};

module.exports = (req, res) => {
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Content-Type', 'application/json');
  const url = req.url || "/";

  if (url === "/" || url.includes("manifest.json")) {
    return res.end(JSON.stringify(manifest));
  }
  if (url.includes("/search")) {
    return res.end(JSON.stringify({ tracks: [] }));
  }
  if (url.includes("/stream")) {
    return res.end(JSON.stringify({ streams: [] }));
  }
  return res.end(JSON.stringify(manifest));
};
